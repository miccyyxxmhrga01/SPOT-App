      allow create, update: if owner(uid) && member()
        && ((request.resource.data.userId == uid && request.resource.data.keys().hasOnly(['userId','title','media','cover','audience','updatedAt'])
            && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 32
            && request.resource.data.cover is int && request.resource.data.cover >= 0 && request.resource.data.cover < request.resource.data.media.size()
            && audienceAllowed(request.resource.data.audience, uid) && request.resource.data.updatedAt == request.time
            && highlightMedia(request.resource.data.media, uid)) || protectAudience(resource.data, request.resource.data));
      allow delete: if owner(uid) && member();
    }
    // Opportunities and event hiring use verified, completed account roles.
    function workReady() { return member() && communityReady(); }
    function seeker() { return workReady() && communityAccount().accountType == 'talent_seeker'; }
    function creator() { return workReady() && communityAccount().accountType == 'student'; }
    function opportunityPath(id) { return /databases/$(database)/documents/opportunities/$(id); }
    function openOpportunity(d) { return d.status == 'open' && d.deadline > request.time; }
    match /opportunities/{id} {
      allow get: if member();
      allow list: if member() && request.query.limit != null && request.query.limit <= 30;
      allow create: if seeker()
        && request.resource.data.keys().hasAll(['seekerId','title','kind','description','category','location','deadline','status','createdAt'])
        && request.resource.data.keys().hasOnly(['seekerId','title','kind','description','category','location','deadline','status','createdAt'])
        && request.resource.data.seekerId == request.auth.uid
        && textWithin(request.resource.data.title, 2, 100)
        && request.resource.data.kind in ['job','audition']
        && textWithin(request.resource.data.description, 10, 3000)
        && textWithin(request.resource.data.category, 1, 60)
        && textWithin(request.resource.data.location, 1, 160)
