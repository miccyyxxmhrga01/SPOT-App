        && after.likesCount == before.get('likesCount', 0) + (next ? 1 : 0) - (storyReaction(id, request.auth.uid) ? 1 : 0);
    }
    function storyOverlay(a) {
      let x = a.x; let y = a.y; let size = a.size; let color = a.color; let text = a.text;
      return a.keys().hasOnly(['id','text','x','y','size','color','background'])
        && a.id.matches('[a-zA-Z0-9_-]{1,80}') && text is string && text.size() > 0 && text.size() <= 160
        && x >= 0 && x <= 1 && y >= 0 && y <= 1 && size >= 0.025 && size <= 0.15
        && color is int && color >= 0 && color <= 4294967295 && a.background is bool;
    }
    function storyOverlays(a) {
      let n = a.size();
      return a is list && n <= 4 && (n < 1 || storyOverlay(a[0])) && (n < 2 || storyOverlay(a[1]))
        && (n < 3 || storyOverlay(a[2])) && (n < 4 || storyOverlay(a[3]));
    }
    function storyComposition(c) {
      return c is map && c.keys().hasOnly(['scale','offsetX','offsetY','fill','rotation','trimStartMs','trimEndMs','muted','imageDurationMs','overlays'])
        && c.scale is number && c.scale >= 1 && c.scale <= 4
        && c.offsetX is number && c.offsetX >= -1 && c.offsetX <= 1
        && c.offsetY is number && c.offsetY >= -1 && c.offsetY <= 1
        && c.fill is bool && c.rotation is int && c.rotation >= 0 && c.rotation <= 3
        && c.trimStartMs is int && c.trimStartMs >= 0 && c.trimStartMs <= 300000
        && c.trimEndMs is int && (c.trimEndMs == 0 || (c.trimEndMs > c.trimStartMs && c.trimEndMs <= c.trimStartMs + 60000))
        && c.muted is bool && c.imageDurationMs is int && c.imageDurationMs >= 1000 && c.imageDurationMs <= 60000
