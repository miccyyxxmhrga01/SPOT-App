    function highlightPostItem(m, source) {
      // Invalid indexes fail closed on the indexed read; cache it once per item.
      let item = source.media[m.index];
      return m.url == item.url && m.type == (item.contentType.matches('video/.*') ? 'video' : 'image');
    }
    function highlightItem(m, uid) {
      let story = m.source == 'story';
      let source = story ? get(/databases/$(database)/documents/stories/$(m.sourceId)).data : get(/databases/$(database)/documents/posts/$(m.sourceId)).data;
      return source.userId == uid && (story
        ? (m.keys().hasOnly(['source','sourceId','index','url','type','composition']) && m.index == 0
          && m.url == source.mediaUrl && m.type == source.mediaType && m.get('composition', {}) == source.get('composition', {}))
        : (m.source == 'post' && m.keys().hasOnly(['source','sourceId','index','url','type'])
          && (!('media' in source) ? (m.index == 0 && m.url == source.mediaUrl && m.type == source.mediaType) : highlightPostItem(m, source))));
    }
    function highlightMedia(items, uid) {
      let count = items.size();
      return items is list && count > 0 && count <= 8
        && highlightItem(items[0], uid)
        && (count < 2 || highlightItem(items[1], uid)) && (count < 3 || highlightItem(items[2], uid))
        && (count < 4 || highlightItem(items[3], uid)) && (count < 5 || highlightItem(items[4], uid))
        && (count < 6 || highlightItem(items[5], uid)) && (count < 7 || highlightItem(items[6], uid))
        && (count < 8 || highlightItem(items[7], uid));
    }
    function canReadHighlight(uid, data) {
