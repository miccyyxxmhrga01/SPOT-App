        && request.resource.data.mediaUrl.matches('https://res[.]cloudinary[.]com/jcuzzxsz/(image|video)/upload/(v[0-9]+/)?spot/stories/' + request.auth.uid + '/' + id + '/.{1,1000}')
        && request.resource.data.mediaType in ['image','video'] && request.resource.data.createdAt == request.time
