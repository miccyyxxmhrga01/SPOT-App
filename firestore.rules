rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validAccount(uid) {
      let data = request.resource.data;
      return request.auth.token.email_verified == true
        && data.uid == uid
        && data.email == request.auth.token.email
        && data.emailVerified == true
        && data.profileCompleted is bool
        && data.get('isPrivate', false) is bool && data.get('privacyUpdating', false) is bool
        && data.get('pronouns', '') is string && data.get('pronouns', '').size() <= 40
        && data.get('links', '') is string && data.get('links', '').size() <= 300
        && data.get('gender', '') is string && data.get('gender', '').size() <= 40
        && data.keys().hasOnly([
          'uid', 'email', 'emailVerified', 'fullName', 'displayName', 'username',
          'course', 'talentCategories', 'bio', 'profileImageUrl', 'accountType',
          'organization', 'seekingTalents', 'profileCompleted', 'createdAt',
          'verifiedAt', 'updatedAt', 'pronouns', 'links', 'gender', 'isPrivate', 'privacyUpdating'
        ]);
    }

    // Private account records include email addresses. Public discovery needs
    // separate public profile documents and rules before it is enabled.
    match /users/{uid} {
      allow get: if owner(uid);
      allow create: if owner(uid) && validAccount(uid)
        && request.resource.data.createdAt == request.time;
      allow update: if owner(uid) && validAccount(uid)
        && request.resource.data.createdAt == resource.data.createdAt
        && (!resource.data.get('profileCompleted', false) || request.resource.data.profileCompleted == true)
        && (!(resource.data.get('accountType', '') in ['student','talent_seeker'])
          || !resource.data.get('profileCompleted', false)
          || request.resource.data.get('accountType', '') == resource.data.accountType);
    }

    function member() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function canReadPost(data) {
      return member() && (data.audience == 'public' || data.userId == request.auth.uid
        || (data.audience == 'followers' && exists(/databases/$(database)/documents/users/$(data.userId)/followers/$(request.auth.uid))));
    }
    function validMedia(media, urlPattern) {
      // Shared prefixes keep ten-file albums within Firestore's expression budget.
      // Required property reads below reject missing or incorrectly typed values.
      return media.keys().hasOnly(['url', 'contentType', 'storagePath', 'thumbnailUrl'])
        && media.storagePath is string
        && media.url.matches(urlPattern)
        && media.contentType.matches('(image|video)/[a-zA-Z0-9.+-]{1,80}')
        && (media.thumbnailUrl == '' || media.thumbnailUrl.matches(urlPattern));
    }
    function validAlbum(media, uid, id) {
      let urlPattern = '(https://firebasestorage[.]googleapis[.]com/v0/b/login-a39d3[.]firebasestorage[.]app/o/posts%2F' + uid + '%2F' + id + '%2F'
        + '|https://res[.]cloudinary[.]com/jcuzzxsz/(image|video)/upload/(so_0,w_960,c_limit,q_auto/)?(v[0-9]+/)?spot/posts/' + uid + '/' + id + '/).{1,1000}';
      let count = media.size();
      return media is list && count <= 10
        && (count < 1 || validMedia(media[0], urlPattern))
        && (count < 2 || validMedia(media[1], urlPattern))
        && (count < 3 || validMedia(media[2], urlPattern))
        && (count < 4 || validMedia(media[3], urlPattern))
        && (count < 5 || validMedia(media[4], urlPattern))
        && (count < 6 || validMedia(media[5], urlPattern))
        && (count < 7 || validMedia(media[6], urlPattern))
        && (count < 8 || validMedia(media[7], urlPattern))
        && (count < 9 || validMedia(media[8], urlPattern))
        && (count < 10 || validMedia(media[9], urlPattern));
    }
    function validAuthor(author, uid, audience) {
      let account = get(/databases/$(database)/documents/users/$(uid)).data;
      return account.profileCompleted == true
        && (audience != 'public' || (!account.get('isPrivate', false) && !account.get('privacyUpdating', false)))
        && author is map
        && author.keys().hasOnly(['displayName', 'username', 'talent', 'course', 'profileImageUrl'])
        && author.displayName == account.displayName && author.username == account.username
        && author.course == account.course && author.profileImageUrl == account.profileImageUrl
        && author.talent is string && author.talent.size() <= 100;
    }
    function validFlatPostFields(data) {
      let fields = ['username', 'displayName', 'userProfileImageUrl', 'talentCategory', 'mediaUrl', 'mediaType', 'commentsCount'];
      return !data.keys().hasAny(fields) ||
        (data.keys().hasAll(fields) && data.username == data.author.username && data.displayName == data.author.displayName
          && data.userProfileImageUrl == data.author.profileImageUrl
          && data.talentCategory is string && data.talentCategory.size() <= 60
          && data.mediaUrl == (data.media.size() > 0 ? data.media[0].url : '')
          && data.mediaType == (data.media.size() > 0 && data.media[0].contentType.matches('video/.*') ? 'video' : 'image')
          && data.commentsCount == 0);
    }
    function validPost(data, id) {
      return member() && data.keys().hasAll(['userId', 'author', 'caption', 'categories', 'tags', 'media', 'hasMedia',
          'audience', 'location', 'taggedPeople', 'likesCount', 'viewsCount', 'popularityScore', 'createdAt'])
        && data.keys().hasOnly(['userId', 'author', 'caption', 'categories', 'tags', 'media', 'hasMedia',
          'audience', 'location', 'taggedPeople', 'likesCount', 'viewsCount', 'popularityScore', 'createdAt',
          'username', 'displayName', 'userProfileImageUrl', 'talentCategory', 'mediaUrl', 'mediaType', 'commentsCount', 'aiCaption', 'aiTagged', 'aiCategorySuggested'])
        && data.get('aiCaption', false) is bool && data.get('aiTagged', false) is bool && data.get('aiCategorySuggested', false) is bool
        && validFlatPostFields(data)
        && (!('commentsCount' in data) || data.commentsCount == 0)
        && data.userId == request.auth.uid && data.userId.matches('[a-zA-Z0-9_-]{1,128}')
        && id.matches('[a-zA-Z0-9_-]{1,100}') && validAuthor(data.author, data.userId, data.audience)
        && data.caption is string && data.caption.size() <= 2000
        && (data.caption.size() > 0 || data.media.size() > 0)
        && data.categories is list && data.categories.size() <= 8
        && data.tags is list && data.tags.size() <= 20
        && data.taggedPeople is list && data.taggedPeople.size() <= 20
        && data.location is string && data.location.size() <= 160
        && data.audience in ['public', 'followers', 'private']
        && validAlbum(data.media, data.userId, id) && data.hasMedia == (data.media.size() > 0)
        && data.likesCount == 0 && data.viewsCount == 0 && data.popularityScore == 0
        && data.createdAt == request.time;
    }
    function beforeInteraction(id, uid) {
      let path = /databases/$(database)/documents/posts/$(id)/interactions/$(uid);
      return exists(path) ? get(path).data : {'liked': false, 'viewed': false};
    }
    function counterUpdate(id, before, after) {
      let previous = beforeInteraction(id, request.auth.uid);
      let next = getAfter(/databases/$(database)/documents/posts/$(id)/interactions/$(request.auth.uid)).data;
      let likeDelta = (next.liked ? 1 : 0) - (previous.liked ? 1 : 0);
      let viewDelta = (next.viewed ? 1 : 0) - (previous.viewed ? 1 : 0);
      return after.diff(before).affectedKeys().hasOnly(['likesCount', 'viewsCount', 'popularityScore'])
        && after.likesCount is int && after.viewsCount is int && after.popularityScore is int
        && after.likesCount >= 0 && after.viewsCount >= 0
        && after.likesCount == before.get('likesCount', 0) + likeDelta
        && after.viewsCount == before.get('viewsCount', 0) + viewDelta
        && viewDelta >= 0 && (before.userId != request.auth.uid || viewDelta == 0)
        && after.popularityScore == after.likesCount * 5 + after.viewsCount;
    }
    match /posts/{id} {
      // Authenticated authors must be able to check whether a retry's id already exists.
      allow get: if member() && (!exists(/databases/$(database)/documents/posts/$(id)) || canReadPost(resource.data));
      allow list: if canReadPost(resource.data) && request.query.limit != null && request.query.limit <= 30;
      allow create: if validPost(request.resource.data, id);
      allow update: if canReadPost(resource.data) && (protectAudience(resource.data, request.resource.data) || counterUpdate(id, resource.data, request.resource.data) || commentCountUpdate(id, resource.data, request.resource.data) || deletedCommentCount(id, resource.data, request.resource.data));
      match /interactions/{uid} {
        allow get: if owner(uid) && canReadPost(get(/databases/$(database)/documents/posts/$(id)).data);
        allow create, update: if owner(uid) && canReadPost(get(/databases/$(database)/documents/posts/$(id)).data)
          && request.resource.data.keys().hasAll(['liked', 'viewed'])
          && request.resource.data.keys().hasOnly(['liked', 'viewed'])
          && request.resource.data.liked is bool && request.resource.data.viewed is bool
          && (!beforeInteraction(id, uid).viewed || request.resource.data.viewed)
          && counterUpdate(id, get(/databases/$(database)/documents/posts/$(id)).data,
            getAfter(/databases/$(database)/documents/posts/$(id)).data);
      }
    }
    // Public identity contains only the fields a member chooses to show on their profile.
    function validPublicProfile(uid, d) {
      let a = getAfter(/databases/$(database)/documents/users/$(uid)).data;
      return a.profileCompleted == true
        && d.keys().hasAll(['displayName','username','profileImageUrl','nameKey','usernameKey'])
        && d.keys().hasOnly(['displayName','username','profileImageUrl','nameKey','usernameKey','bio','course','talentCategories',
          'accountType','organization','seekingTalents','pronouns','links','gender','isPrivate','privacyUpdating'])
        && d.displayName == a.displayName && d.username == a.username && d.profileImageUrl == a.profileImageUrl
        && d.nameKey is string && d.nameKey.size() <= 200 && d.usernameKey is string && d.usernameKey.size() <= 200
        && (!('bio' in d) || d.bio == a.get('bio', '')) && (!('course' in d) || d.course == a.get('course', ''))
        && (!('talentCategories' in d) || d.talentCategories == a.get('talentCategories', [])) && (!('seekingTalents' in d) || d.seekingTalents == a.get('seekingTalents', []))
        && (!('organization' in d) || d.organization == a.get('organization', '')) && (!('accountType' in d) || d.accountType == a.get('accountType', ''))
        && (!('pronouns' in d) || d.pronouns == a.get('pronouns', '')) && (!('links' in d) || d.links == a.get('links', '')) && (!('gender' in d) || d.gender == a.get('gender', ''))
        && d.get('isPrivate', false) == a.get('isPrivate', false) && d.get('privacyUpdating', false) == a.get('privacyUpdating', false);
    }
    match /publicProfiles/{uid} {
      allow get: if member();
      allow list: if member() && request.query.limit != null && request.query.limit <= 30;
      allow create, update: if owner(uid) && member() && validPublicProfile(uid, request.resource.data);
    }
    match /usernames/{name} {
      allow get: if member();
      allow create: if member() && name.matches('[a-z0-9_]{3,30}')
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == name;
      allow update: if owner(resource.data.uid) && request.resource.data == resource.data;
      allow delete: if owner(resource.data.uid)
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username != name;
    }
    function audienceAllowed(audience, uid) {
      let a = get(/databases/$(database)/documents/users/$(uid)).data;
      return audience in ['public','followers','private']
        && (audience != 'public' || (!a.get('isPrivate', false) && !a.get('privacyUpdating', false)));
    }
    function protectAudience(before, after) {
      return owner(before.userId) && after.diff(before).affectedKeys().hasOnly(['audience'])
        && before.audience == 'public' && after.audience == 'followers';
    }
    function chatMember(data) { return member() && request.auth.uid in data.memberIds; }
    function chatVisible(data) { return member() && (request.auth.uid in data.memberIds || request.auth.uid in data.invitedIds); }
    function noBlock(a, b) {
      return !exists(/databases/$(database)/documents/users/$(a)/blockedUsers/$(b))
        && !exists(/databases/$(database)/documents/users/$(b)/blockedUsers/$(a));
    }
    function chatSend(data) {
      return chatMember(data) && (data.demo || (data.memberIds.size() >= 2 &&
        (data.kind == 'group' || noBlock(data.partyIds[0], data.partyIds[1]))));
    }
    function chatPerson(data, uid) {
      let p = get(/databases/$(database)/documents/publicProfiles/$(uid)).data;
      return data.keys().hasOnly(['displayName','username','profileImageUrl'])
        && data.displayName == p.displayName && data.username == p.username && data.profileImageUrl == p.profileImageUrl;
    }
    function chatPeople(data) {
      let ids = data.partyIds;
      let p = data.people;
      return p is map && p.keys().hasOnly(ids) && p.keys().hasAll(ids)
        && chatPerson(p[ids[0]], ids[0])
        && (ids.size() < 2 || chatPerson(p[ids[1]], ids[1]))
        && (ids.size() < 3 || chatPerson(p[ids[2]], ids[2]))
        && (ids.size() < 4 || chatPerson(p[ids[3]], ids[3]))
        && (ids.size() < 5 || chatPerson(p[ids[4]], ids[4]))
        && (ids.size() < 6 || chatPerson(p[ids[5]], ids[5]))
        && (ids.size() < 7 || chatPerson(p[ids[6]], ids[6]))
        && (ids.size() < 8 || chatPerson(p[ids[7]], ids[7]));
    }
    function newChat(data, id) {
      return member() && id.matches('[a-zA-Z0-9_-]{1,200}')
        && data.keys().hasAll(['kind','demo','title','creatorId','partyIds','memberIds','invitedIds','people','inviteNote','preview','lastMessageId','lastSenderId','createdAt','updatedAt'])
        && data.keys().hasOnly(['kind','demo','title','creatorId','partyIds','memberIds','invitedIds','people','inviteNote','preview','lastMessageId','lastSenderId','createdAt','updatedAt'])
        && data.creatorId == request.auth.uid && data.kind in ['direct','group'] && data.demo is bool
        && data.title is string && data.title.size() <= 60 && data.inviteNote is string && data.inviteNote.size() <= 500
        && data.partyIds is list && data.partyIds.size() <= 8 && data.partyIds.toSet().size() == data.partyIds.size()
        && data.memberIds == [request.auth.uid] && data.invitedIds is list
        && data.createdAt == request.time && data.updatedAt == request.time
        && ((data.demo && data.partyIds == [request.auth.uid] && data.invitedIds == [] && data.people == {}
              && data.preview is string && data.preview.size() <= 160 && data.lastSenderId == 'demo'
              && data.lastMessageId == 'sample-1')
          || (!data.demo && data.partyIds.size() >= 2 && request.auth.uid in data.partyIds
              && data.invitedIds.toSet() == data.partyIds.toSet().difference([request.auth.uid].toSet())
              && data.invitedIds.size() == data.partyIds.size() - 1
              && (data.kind == 'group' || (data.partyIds.size() == 2 && noBlock(data.partyIds[0], data.partyIds[1])))
              && chatPeople(data) && data.preview == '' && data.lastMessageId == '' && data.lastSenderId == ''));
    }
    function membershipChange(before, after) {
      let uid = request.auth.uid;
      return !before.demo && after.diff(before).affectedKeys().hasOnly(['memberIds','invitedIds'])
        && after.memberIds is list && after.invitedIds is list
        && ((uid in before.invitedIds
            && after.invitedIds == before.invitedIds.removeAll([uid])
            && (after.memberIds == before.memberIds || (noBlock(uid, before.creatorId) && after.memberIds == before.memberIds.concat([uid]))))
          || (uid in before.memberIds && before.kind == 'group'
            && after.memberIds == before.memberIds.removeAll([uid]) && after.invitedIds == before.invitedIds));
    }
    function chatPreview(id, before, after) {
      let m = getAfter(/databases/$(database)/documents/conversations/$(id)/messages/$(after.lastMessageId)).data;
      return chatSend(before) && after.diff(before).affectedKeys().hasOnly(['preview','lastMessageId','lastSenderId','updatedAt'])
        && after.updatedAt == request.time && m.createdAt == request.time && m.senderId == request.auth.uid
        && after.lastSenderId == request.auth.uid && after.lastMessageId != before.lastMessageId
        && after.preview is string && after.preview.size() <= 160;
    }
    // Unsending the latest message may only swap the inbox preview; order and unread state stay put.
    function chatUnsendPreview(id, before, after) {
      let m = getAfter(/databases/$(database)/documents/conversations/$(id)/messages/$(before.lastMessageId)).data;
      return chatMember(before) && after.diff(before).affectedKeys().hasOnly(['preview'])
        && before.lastSenderId == request.auth.uid && m.senderId == request.auth.uid
        && ('unsentAt' in m) && after.preview == 'Message unsent';
    }
    function chatAttachment(a, id, messageId) {
      return a == null || (a is map && a.keys().hasAll(['path','mime','name','size'])
        && a.keys().hasOnly(['path','mime','name','size','url','key','iv'])
        && a.path == 'chat_media/' + id + '/' + request.auth.uid + '/' + messageId
        && a.mime.matches('(image|video)/[a-zA-Z0-9.+-]{1,80}')
        && a.name is string && a.name.size() <= 120 && a.size is int && a.size > 0 && a.size <= 25 * 1024 * 1024
        && (a.keys().hasAny(['url','key','iv']) == false
          || (a.keys().hasAll(['url','key','iv'])
            && a.url is string && a.url.matches('https://res[.]cloudinary[.]com/jcuzzxsz/raw/upload/v[0-9]+/spot/chat_media/' + id + '/' + request.auth.uid + '/' + messageId + '/[a-zA-Z0-9_.-]+[.]bin')
            && a.key is string && a.key.matches('[a-zA-Z0-9+/]{43}=')
            && a.iv is string && a.iv.matches('[a-zA-Z0-9+/]{16}'))));
    }
    match /conversations/{id} {
      allow get: if member() && (!exists(/databases/$(database)/documents/conversations/$(id)) || chatVisible(resource.data));
      allow list: if chatVisible(resource.data) && request.query.limit != null && request.query.limit <= 100;
      allow create: if newChat(request.resource.data, id);
      allow update: if member() && (membershipChange(resource.data, request.resource.data) || chatPreview(id, resource.data, request.resource.data)
        || chatUnsendPreview(id, resource.data, request.resource.data));
      match /messages/{messageId} {
        allow get: if chatMember(get(/databases/$(database)/documents/conversations/$(id)).data);
        allow list: if chatMember(get(/databases/$(database)/documents/conversations/$(id)).data)
          && request.query.limit != null && request.query.limit <= 50;
        allow create: if member() && messageId.matches('[a-zA-Z0-9_-]{1,100}')
          && request.resource.data.keys().hasAll(['senderId','text','attachment','createdAt'])
          && request.resource.data.keys().hasOnly(['senderId','text','attachment','createdAt'])
          && request.resource.data.createdAt == request.time
          && request.resource.data.text is string && request.resource.data.text.size() <= 4000
          && (request.resource.data.text.size() > 0 || request.resource.data.attachment != null)
          && chatAttachment(request.resource.data.attachment, id, messageId)
          && ((chatSend(getAfter(/databases/$(database)/documents/conversations/$(id)).data)
              && request.resource.data.senderId == request.auth.uid
              && getAfter(/databases/$(database)/documents/conversations/$(id)).data.lastMessageId == messageId
              && getAfter(/databases/$(database)/documents/conversations/$(id)).data.updatedAt == request.time)
            || (getAfter(/databases/$(database)/documents/conversations/$(id)).data.demo == true
              && getAfter(/databases/$(database)/documents/conversations/$(id)).data.memberIds == [request.auth.uid]
              && request.resource.data.senderId == 'demo' && messageId in ['sample-0','sample-1']
              && request.resource.data.attachment == null));
        // Unsend: only the sender, once, and it must clear the text and attachment for everyone.
        allow update: if chatMember(get(/databases/$(database)/documents/conversations/$(id)).data)
          && resource.data.senderId == request.auth.uid && !('unsentAt' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','attachment','unsentAt'])
          && request.resource.data.text == '' && request.resource.data.attachment == null
          && request.resource.data.unsentAt == request.time;
      }
    }
    match /users/{uid}/chatSettings/{id} {
      allow read: if owner(uid) && member();
      allow create, update: if owner(uid) && member() && chatMember(get(/databases/$(database)/documents/conversations/$(id)).data)
        && request.resource.data.keys().hasOnly(['nickname','muted','hiddenAt','readAt'])
        && (!('nickname' in request.resource.data) || (request.resource.data.nickname is string && request.resource.data.nickname.size() <= 60))
        && (!('muted' in request.resource.data) || request.resource.data.muted is bool)
        && (!('hiddenAt' in request.resource.data) || (request.resource.data.hiddenAt is timestamp && request.resource.data.hiddenAt <= request.time))
        && (!('readAt' in request.resource.data) || (request.resource.data.readAt is timestamp && request.resource.data.readAt <= request.time));
      // "Delete for you": private markers; other members never see them.
      match /hiddenMessages/{messageId} {
        allow read: if owner(uid) && member();
        allow create, update: if owner(uid) && member() && messageId.matches('[a-zA-Z0-9_-]{1,100}')
          && request.resource.data.keys().hasOnly(['createdAt']) && request.resource.data.createdAt == request.time;
      }
    }
    match /users/{uid}/blockedUsers/{other} {
      allow read, delete: if owner(uid) && member();
      allow create, update: if owner(uid) && member() && uid != other
        && request.resource.data.keys().hasOnly(['createdAt']) && request.resource.data.createdAt == request.time;
    }
    match /conversationReports/{id} {
      allow create, update: if member() && request.resource.data.reporterId == request.auth.uid
        && id == request.resource.data.conversationId + '_' + request.auth.uid
        && chatVisible(get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data)
        && request.resource.data.keys().hasOnly(['conversationId','reporterId','reason','createdAt'])
        && request.resource.data.reason is string && request.resource.data.reason.size() >= 5 && request.resource.data.reason.size() <= 1000
        && request.resource.data.createdAt == request.time;
      allow get: if member() && resource.data.reporterId == request.auth.uid;
    }

    function commentCountUpdate(id, before, after) {
      let cid = after.lastCommentId;
      let path = /databases/$(database)/documents/posts/$(id)/comments/$(cid);
      let c = getAfter(path).data;
      return after.diff(before).affectedKeys().hasOnly(['commentsCount', 'lastCommentId'])
        && after.commentsCount is int && after.commentsCount == before.get('commentsCount', 0) + 1
        && !exists(path) && c.userId == request.auth.uid && c.createdAt == request.time;
    }
    function deletedCommentCount(id, before, after) {
      let cid = after.lastDeletedCommentId;
      let path = /databases/$(database)/documents/posts/$(id)/comments/$(cid);
      return after.diff(before).affectedKeys().hasOnly(['commentsCount','lastDeletedCommentId'])
        && get(path).data.userId == request.auth.uid && !get(path).data.get('deleted', false)
        && getAfter(path).data.get('deleted', false) == true
        && after.commentsCount == before.commentsCount - 1 && after.commentsCount >= 0;
    }
    function deleteComment(id, cid, before, after) {
      return owner(before.userId) && !before.get('deleted', false)
        && after.diff(before).affectedKeys().hasOnly(['deleted','text']) && after.deleted == true && after.text == ''
        && getAfter(/databases/$(database)/documents/posts/$(id)).data.lastDeletedCommentId == cid
        && deletedCommentCount(id, get(/databases/$(database)/documents/posts/$(id)).data, getAfter(/databases/$(database)/documents/posts/$(id)).data);
    }
    function validComment(id, cid, d) {
      let parent = get(/databases/$(database)/documents/posts/$(id)).data;
      let next = getAfter(/databases/$(database)/documents/posts/$(id)).data;
      let account = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return canReadPost(parent) && account.profileCompleted == true
        && d.keys().hasAll(['id','postId','userId','username','displayName','profileImageUrl','text','createdAt','likesCount'])
        && d.keys().hasOnly(['id','postId','userId','username','displayName','profileImageUrl','text','createdAt','likesCount'])
        && d.id == cid && d.postId == id && d.userId == request.auth.uid
        && d.username == account.username && d.displayName == account.displayName && d.profileImageUrl == account.profileImageUrl
        && d.text is string && d.text.size() > 0 && d.text.size() <= 2000
        && d.createdAt == request.time && d.likesCount == 0
        && next.lastCommentId == cid && next.commentsCount == parent.get('commentsCount', 0) + 1;
    }
    function commentLikeUpdate(id, cid, before, after) {
      let path = /databases/$(database)/documents/posts/$(id)/comments/$(cid)/likes/$(request.auth.uid);
      let old = exists(path) && get(path).data.liked;
      let next = getAfter(path).data.liked;
