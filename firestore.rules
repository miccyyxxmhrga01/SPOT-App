    }
    function validWorkSource(d) {
      return (d.kind == 'invitation' && get(eventPath(d.sourceId)).data.organizerId == d.seekerId
          && get(eventPath(d.sourceId)).data.title == d.title && get(eventPath(d.sourceId)).data.startsAt > request.time)
        || (d.kind == 'application' && get(opportunityPath(d.sourceId)).data.seekerId == d.seekerId
          && get(opportunityPath(d.sourceId)).data.title == d.title && openOpportunity(get(opportunityPath(d.sourceId)).data));
    }
    function requestParty(d) { return member() && (d.seekerId == request.auth.uid || d.creatorId == request.auth.uid); }
    function newTalentRequest(id, d) {
      return workReady()
        && d.keys().hasAll(['kind','sourceId','seekerId','creatorId','title','details','status','createdAt','updatedAt'])
        && d.keys().hasOnly(['kind','sourceId','seekerId','creatorId','title','details','status','createdAt','updatedAt'])
        && d.kind in ['invitation','application']
        && textWithin(d.sourceId,1,128) && textWithin(d.creatorId,1,128) && textWithin(d.seekerId,1,128)
        && id == d.kind + '_' + d.sourceId + '_' + d.creatorId
        && d.creatorId != d.seekerId && noBlock(d.creatorId,d.seekerId)
        && ((d.kind == 'invitation' && seeker() && d.seekerId == request.auth.uid
          && get(/databases/$(database)/documents/users/$(d.creatorId)).data.accountType == 'student'
          && get(/databases/$(database)/documents/users/$(d.creatorId)).data.profileCompleted == true)
          || (d.kind == 'application' && creator() && d.creatorId == request.auth.uid))
        && textWithin(d.title,2,100) && textWithin(d.details,10,2000) && validWorkSource(d)
        && d.status == 'pending' && d.createdAt == request.time && d.updatedAt == request.time;
    }
    function talentTransition(b, a) {
      let sender = b.kind == 'invitation' ? b.seekerId : b.creatorId;
      let recipient = b.kind == 'invitation' ? b.creatorId : b.seekerId;
      return b.status == 'pending' && a.diff(b).affectedKeys().hasOnly(['status','updatedAt'])
        && a.updatedAt == request.time
        && ((request.auth.uid == sender && a.status == 'withdrawn')
          || (request.auth.uid == recipient && a.status in ['accepted','declined']
            && noBlock(b.creatorId,b.seekerId) && (a.status != 'accepted' || validWorkSource(b))));
    }
    match /talentRequests/{id} {
      // Exact missing-document checks support idempotent forms and a creator's application status.
      allow get: if member() && (!exists(/databases/$(database)/documents/talentRequests/$(id)) || requestParty(resource.data));
      allow list: if requestParty(resource.data) && request.query.limit != null && request.query.limit <= 30;
      allow create: if newTalentRequest(id, request.resource.data);
      allow update: if requestParty(resource.data) && talentTransition(resource.data, request.resource.data);
    }

  }
}
