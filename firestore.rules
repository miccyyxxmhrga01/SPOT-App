        && request.resource.data.keys().hasOnly(['groupId','name','nameKey','description','imageUrl','category','privacy','ownerId','ownerName','ownerProfileImageUrl','memberCount','createdAt'])
        && request.resource.data.groupId == id && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerName == communityAccount().displayName && request.resource.data.ownerProfileImageUrl == communityAccount().profileImageUrl
        && textWithin(request.resource.data.name, 2, 80) && request.resource.data.nameKey == request.resource.data.name.lower()
        && textWithin(request.resource.data.description, 1, 2000) && textWithin(request.resource.data.category, 1, 60)
