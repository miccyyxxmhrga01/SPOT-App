        && request.resource.data.likes is bool && request.resource.data.comments is bool && request.resource.data.follows is bool;
    }
    function storyReaction(id, uid) {
      let path = /databases/$(database)/documents/stories/$(id)/reactions/$(uid);
      return exists(path) ? get(path).data.liked : false;
    }
    function storyReactionAllowed(d) {
      return canReadPost(d) && d.userId != request.auth.uid && !d.deleted
        && d.createdAt + duration.value(24, 'h') > request.time && noBlock(d.userId, request.auth.uid);
    }
    function storyCounter(id, before, after) {
      let next = getAfter(/databases/$(database)/documents/stories/$(id)/reactions/$(request.auth.uid)).data.liked;
      return storyReactionAllowed(before) && after.diff(before).affectedKeys().hasOnly(['likesCount'])
