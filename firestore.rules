    match /stories/{id} {
      allow get: if member() && (!exists(/databases/$(database)/documents/stories/$(id)) || canReadPost(resource.data));
      allow list: if canReadPost(resource.data) && request.query.limit != null && request.query.limit <= 100;
      allow create: if member() && owner(request.resource.data.userId)
