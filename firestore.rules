    function communityAccount() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function communityReady() { return signedIn() && communityAccount().profileCompleted == true; }
    function textWithin(value, min, max) { return value is string && value.size() >= min && value.size() <= max; }
    function communityImage(url, collection, uid, id) {
      return url == '' || (url is string && url.matches('https://res[.]cloudinary[.]com/jcuzzxsz/image/upload/(v[0-9]+/)?spot/' + collection + '/' + uid + '/' + id + '/.{1,1000}'));
    }
    function personRecord(d, uid) {
      return d.keys().hasAll(['userId','displayName','profileImageUrl','role','createdAt'])
