rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function member() { return request.auth != null && request.auth.token.email_verified == true; }
    function readablePost(id) {
      let post = firestore.get(/databases/(default)/documents/posts/$(id)).data;
      return post.audience == 'public' || post.userId == request.auth.uid
        || (post.audience == 'followers' && firestore.exists(/databases/(default)/documents/users/$(post.userId)/followers/$(request.auth.uid)));
    }
    match /posts/{uid}/{id}/{file} {
      allow read: if member() && (request.auth.uid == uid || readablePost(id));
      allow create, update: if member() && request.auth.uid == uid
        && !firestore.exists(/databases/(default)/documents/posts/$(id))
        && request.resource.size > 0 && request.resource.size <= 50 * 1024 * 1024
        && request.resource.contentType.matches('(image|video)/.*');
      allow delete: if member() && request.auth.uid == uid
        && !firestore.exists(/databases/(default)/documents/posts/$(id));
    }
    function chatMember(id) {
      return member() && request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(id)).data.memberIds;
    }
    function canSendChat(id) {
      let chat = firestore.get(/databases/(default)/documents/conversations/$(id)).data;
      // Delivery and blocking are enforced by the atomic Firestore message write.
      // Keep Storage authorization within its two cross-service document calls.
      return chatMember(id) && (chat.demo || chat.memberIds.size() >= 2);
    }
    match /chat_media/{id}/{uid}/{messageId} {
      allow read: if chatMember(id);
      allow create, update: if request.auth != null && request.auth.uid == uid && canSendChat(id)
        && !firestore.exists(/databases/(default)/documents/conversations/$(id)/messages/$(messageId))
        && request.resource.size > 0 && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType.matches('(image|video)/.*');
      allow delete: if member() && request.auth.uid == uid
        && !firestore.exists(/databases/(default)/documents/conversations/$(id)/messages/$(messageId));
    }

    match /profile_images/{uid}/{file} {
      allow read: if member();
      allow write: if member() && request.auth.uid == uid && request.resource != null
        && request.resource.size <= 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
  }
}
